# Publish only source, build inputs and the user-facing README.
# Local data, credentials, developer notes and validation evidence stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/*.cs
!/CONTROL-DESIGN.md
!/control-config.json
!/build-source.ps1
!/package-ci.ps1
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/protocol.json
!/PROTOCOL-REFERENCE.md
!/docs/
!/docs/protocol/
!/docs/protocol/*.md
!/tools/material-analysis/
!/tools/material-analysis/*.py
!/tools/material-analysis/*.ps1
!/ExperimentMonitorDemo.exe.config
!/ExperimentMonitorDemo.manifest
!/System.Data.SQLite.dll
!/x64/
!/x86/
!/tools/
!/tools/control-runner/
!/shared/
!/shared/*.cs
# 线协议样例：检查器读取的真实报文，必须入库（交接书 .md 仍留本地）
!/cloud-integration/
!/cloud-integration/example-*.json
/cloud-integration/*.md
!/tools/control-runner/*.cs
!/tools/control-runner/*.ps1
/x64/*
/x86/*
!/x64/SQLite.Interop.dll
!/x86/SQLite.Interop.dll

# Defensive exclusions for runtime data and editor/build artifacts.
**/data/
**/logs/
**/settings/
**/cloud-settings.json
**/settings.json
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.log
**/*.pdb
**/bin/
**/obj/
**/.vs/
**/.vscode/
